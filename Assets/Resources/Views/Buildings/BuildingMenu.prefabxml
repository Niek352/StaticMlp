<UnityPrefab>
    <GameObject name="BuildingMenu">
        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="0, 0" />
        <Canvas m_RenderMode="0" m_SortingOrder="80" />
        <CanvasScaler m_UiScaleMode="1" m_ReferenceResolution="1920, 1080" m_ScreenMatchMode="0" m_MatchWidthOrHeight="0.5" />
        <GraphicRaycaster />
        <BuildingMenuView
            panelRoot="#Panel"
            woodenHutButton="#WoodenHutButton"
            closeButton="#CloseButton"
            selectedBuildingLabel="#SelectedBuildingLabel"
            costLabel="#CostLabel" />

        <GameObject name="Panel" id="Panel">
            <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="330, 238" m_AnchoredPosition="18, 18" />
            <Image m_Color="#17242DEB" m_RaycastTarget="true" />
            <VerticalLayoutGroup
                m_Padding.m_Left="14"
                m_Padding.m_Right="14"
                m_Padding.m_Top="12"
                m_Padding.m_Bottom="12"
                m_Spacing="10"
                m_ChildControlWidth="true"
                m_ChildControlHeight="true"
                m_ChildForceExpandWidth="true"
                m_ChildForceExpandHeight="false" />

            <GameObject name="Title">
                <RectTransform m_SizeDelta="0, 30" />
                <TextMeshProUGUI
                    m_text="Buildings"
                    m_fontSize="22"
                    m_fontStyle="1"
                    m_fontColor="#F4F8F4"
                    m_HorizontalAlignment="1"
                    m_VerticalAlignment="512"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="30" />
            </GameObject>

            <GameObject name="SelectedBuildingLabel" id="SelectedBuildingLabel">
                <RectTransform m_SizeDelta="0, 26" />
                <TextMeshProUGUI
                    m_text="Wooden Hut"
                    m_fontSize="18"
                    m_fontColor="#D9E6D9"
                    m_HorizontalAlignment="1"
                    m_VerticalAlignment="512"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="26" />
            </GameObject>

            <GameObject name="CostLabel" id="CostLabel">
                <RectTransform m_SizeDelta="0, 26" />
                <TextMeshProUGUI
                    m_text="Wood 10  Stone 4"
                    m_fontSize="16"
                    m_fontColor="#BFD2BE"
                    m_HorizontalAlignment="1"
                    m_VerticalAlignment="512"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="26" />
            </GameObject>

            <GameObject name="WoodenHutButton" id="WoodenHutButton">
                <RectTransform m_SizeDelta="0, 42" />
                <Image m_Color="#4C7A52" m_RaycastTarget="true" />
                <Button
                    m_Transition="1"
                    m_Colors.m_NormalColor="#FFFFFF"
                    m_Colors.m_HighlightedColor="#E8F2E4"
                    m_Colors.m_PressedColor="#C4D8BD"
                    m_Colors.m_DisabledColor="#6A7585AA"
                    m_Colors.m_FadeDuration="0.08" />
                <LayoutElement m_PreferredHeight="42" />

                <GameObject name="Label">
                    <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                    <TextMeshProUGUI
                        m_text="Wooden Hut"
                        m_fontSize="16"
                        m_fontStyle="1"
                        m_fontColor="#FFFFFF"
                        m_HorizontalAlignment="2"
                        m_VerticalAlignment="512"
                        m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="CloseButton" id="CloseButton">
                <RectTransform m_SizeDelta="0, 36" />
                <Image m_Color="#334854" m_RaycastTarget="true" />
                <Button
                    m_Transition="1"
                    m_Colors.m_NormalColor="#FFFFFF"
                    m_Colors.m_HighlightedColor="#E5F4FA"
                    m_Colors.m_PressedColor="#C8DCE4"
                    m_Colors.m_DisabledColor="#6A7585AA"
                    m_Colors.m_FadeDuration="0.08" />
                <LayoutElement m_PreferredHeight="36" />

                <GameObject name="Label">
                    <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                    <TextMeshProUGUI
                        m_text="Close"
                        m_fontSize="16"
                        m_fontColor="#FFFFFF"
                        m_HorizontalAlignment="2"
                        m_VerticalAlignment="512"
                        m_RaycastTarget="false" />
                </GameObject>
            </GameObject>
        </GameObject>
    </GameObject>
</UnityPrefab>
