<UnityPrefab>
    <GameObject name="BuildingMenu" id="Root">
        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="0, 0" />
        <Canvas m_RenderMode="0" m_SortingOrder="80" />
        <CanvasScaler m_UiScaleMode="1" m_ReferenceResolution="1920, 1080" m_ScreenMatchMode="0" m_MatchWidthOrHeight="0.5" />
        <CanvasGroup />
        <GraphicRaycaster />
        <BuildingMenuView
            _canvas="#Root"
            _canvasGroup="#Root"
            _graphicRaycaster="#Root"
            _panelRoot="#Panel"
            _closeButton="#CloseButton"
            _selectedBuildingLabel="#SelectedBuildingLabel">
            <Field name="_categoryLabels">
                <Item v="#CategoryServiceLabel" />
                <Item v="#CategoryLogisticsLabel" />
                <Item v="#CategoryHousingLabel" />
                <Item v="#CategoryExtractionLabel" />
                <Item v="#CategoryProductionLabel" />
            </Field>
            <Field name="_cardRoots">
                <Item v="#CampCoreCard" />
                <Item v="#StockpileCard" />
                <Item v="#BedrollShelterCard" />
                <Item v="#LumberCampCard" />
                <Item v="#StoneMineCard" />
                <Item v="#WorkbenchCard" />
            </Field>
            <Field name="_cardButtons">
                <Item v="#CampCoreCard" />
                <Item v="#StockpileCard" />
                <Item v="#BedrollShelterCard" />
                <Item v="#LumberCampCard" />
                <Item v="#StoneMineCard" />
                <Item v="#WorkbenchCard" />
            </Field>
            <Field name="_cardNameLabels">
                <Item v="#CampCoreNameLabel" />
                <Item v="#StockpileNameLabel" />
                <Item v="#BedrollShelterNameLabel" />
                <Item v="#LumberCampNameLabel" />
                <Item v="#StoneMineNameLabel" />
                <Item v="#WorkbenchNameLabel" />
            </Field>
            <Field name="_cardCategoryLabels">
                <Item v="#CampCoreCategoryLabel" />
                <Item v="#StockpileCategoryLabel" />
                <Item v="#BedrollShelterCategoryLabel" />
                <Item v="#LumberCampCategoryLabel" />
                <Item v="#StoneMineCategoryLabel" />
                <Item v="#WorkbenchCategoryLabel" />
            </Field>
            <Field name="_cardCostLabels">
                <Item v="#CampCoreCostLabel" />
                <Item v="#StockpileCostLabel" />
                <Item v="#BedrollShelterCostLabel" />
                <Item v="#LumberCampCostLabel" />
                <Item v="#StoneMineCostLabel" />
                <Item v="#WorkbenchCostLabel" />
            </Field>
        </BuildingMenuView>

        <GameObject name="Panel" id="Panel">
            <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="420, 568" m_AnchoredPosition="18, 18" />
            <Image m_Color="#17242DEB" m_RaycastTarget="true" />
            <VerticalLayoutGroup
                m_Padding.m_Left="14"
                m_Padding.m_Right="14"
                m_Padding.m_Top="12"
                m_Padding.m_Bottom="12"
                m_Spacing="8"
                m_ChildControlWidth="true"
                m_ChildControlHeight="true"
                m_ChildForceExpandWidth="true"
                m_ChildForceExpandHeight="false" />

            <GameObject name="Title">
                <RectTransform m_SizeDelta="0, 30" />
                <TextMeshProUGUI
                    m_text="Buildings"
                    m_fontSize="22"
                    m_fontStyle="1"
                    m_fontColor="#F4F8F4"
                    m_HorizontalAlignment="2"
                    m_VerticalAlignment="512"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="30" />
            </GameObject>

            <GameObject name="SelectedBuildingLabel" id="SelectedBuildingLabel">
                <RectTransform m_SizeDelta="0, 24" />
                <TextMeshProUGUI
                    m_text="Select a building"
                    m_fontSize="16"
                    m_fontColor="#D9E6D9"
                    m_HorizontalAlignment="2"
                    m_VerticalAlignment="512"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="24" />
            </GameObject>

            <GameObject name="Categories">
                <RectTransform m_SizeDelta="0, 54" />
                <VerticalLayoutGroup
                    m_Spacing="2"
                    m_ChildControlWidth="true"
                    m_ChildControlHeight="true"
                    m_ChildForceExpandWidth="true"
                    m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="54" />

                <GameObject name="CategoryServiceLabel" id="CategoryServiceLabel">
                    <RectTransform m_SizeDelta="0, 16" />
                    <TextMeshProUGUI m_text="Service (1)" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="1" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="CategoryLogisticsLabel" id="CategoryLogisticsLabel">
                    <RectTransform m_SizeDelta="0, 16" />
                    <TextMeshProUGUI m_text="Logistics (1)" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="1" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="CategoryHousingLabel" id="CategoryHousingLabel">
                    <RectTransform m_SizeDelta="0, 16" />
                    <TextMeshProUGUI m_text="Housing (1)" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="1" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="CategoryExtractionLabel" id="CategoryExtractionLabel">
                    <RectTransform m_SizeDelta="0, 16" />
                    <TextMeshProUGUI m_text="Extraction (2)" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="1" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="CategoryProductionLabel" id="CategoryProductionLabel">
                    <RectTransform m_SizeDelta="0, 16" />
                    <TextMeshProUGUI m_text="Production (1)" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="1" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="CampCoreCard" id="CampCoreCard">
                <RectTransform m_SizeDelta="0, 58" />
                <Image m_Color="#405E50" m_RaycastTarget="true" />
                <Button m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E8F2E4" m_Colors.m_PressedColor="#C4D8BD" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_FadeDuration="0.08" />
                <VerticalLayoutGroup m_Padding.m_Left="10" m_Padding.m_Right="10" m_Padding.m_Top="4" m_Padding.m_Bottom="4" m_Spacing="0" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="58" />
                <GameObject name="Name" id="CampCoreNameLabel">
                    <RectTransform m_SizeDelta="0, 22" />
                    <TextMeshProUGUI m_text="Camp Core" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Category" id="CampCoreCategoryLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Service" m_fontSize="12" m_fontColor="#D5E4D5" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Cost" id="CampCoreCostLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Wood 10  Stone 4" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="StockpileCard" id="StockpileCard">
                <RectTransform m_SizeDelta="0, 58" />
                <Image m_Color="#405E50" m_RaycastTarget="true" />
                <Button m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E8F2E4" m_Colors.m_PressedColor="#C4D8BD" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_FadeDuration="0.08" />
                <VerticalLayoutGroup m_Padding.m_Left="10" m_Padding.m_Right="10" m_Padding.m_Top="4" m_Padding.m_Bottom="4" m_Spacing="0" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="58" />
                <GameObject name="Name" id="StockpileNameLabel">
                    <RectTransform m_SizeDelta="0, 22" />
                    <TextMeshProUGUI m_text="Stockpile" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Category" id="StockpileCategoryLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Logistics" m_fontSize="12" m_fontColor="#D5E4D5" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Cost" id="StockpileCostLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Wood 12  Stone 2" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="BedrollShelterCard" id="BedrollShelterCard">
                <RectTransform m_SizeDelta="0, 58" />
                <Image m_Color="#405E50" m_RaycastTarget="true" />
                <Button m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E8F2E4" m_Colors.m_PressedColor="#C4D8BD" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_FadeDuration="0.08" />
                <VerticalLayoutGroup m_Padding.m_Left="10" m_Padding.m_Right="10" m_Padding.m_Top="4" m_Padding.m_Bottom="4" m_Spacing="0" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="58" />
                <GameObject name="Name" id="BedrollShelterNameLabel">
                    <RectTransform m_SizeDelta="0, 22" />
                    <TextMeshProUGUI m_text="Bedroll Shelter" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Category" id="BedrollShelterCategoryLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Housing" m_fontSize="12" m_fontColor="#D5E4D5" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Cost" id="BedrollShelterCostLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Wood 10  Stone 2" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="LumberCampCard" id="LumberCampCard">
                <RectTransform m_SizeDelta="0, 58" />
                <Image m_Color="#405E50" m_RaycastTarget="true" />
                <Button m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E8F2E4" m_Colors.m_PressedColor="#C4D8BD" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_FadeDuration="0.08" />
                <VerticalLayoutGroup m_Padding.m_Left="10" m_Padding.m_Right="10" m_Padding.m_Top="4" m_Padding.m_Bottom="4" m_Spacing="0" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="58" />
                <GameObject name="Name" id="LumberCampNameLabel">
                    <RectTransform m_SizeDelta="0, 22" />
                    <TextMeshProUGUI m_text="Lumber Camp" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Category" id="LumberCampCategoryLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Extraction" m_fontSize="12" m_fontColor="#D5E4D5" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Cost" id="LumberCampCostLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Wood 12  Stone 4" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="StoneMineCard" id="StoneMineCard">
                <RectTransform m_SizeDelta="0, 58" />
                <Image m_Color="#405E50" m_RaycastTarget="true" />
                <Button m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E8F2E4" m_Colors.m_PressedColor="#C4D8BD" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_FadeDuration="0.08" />
                <VerticalLayoutGroup m_Padding.m_Left="10" m_Padding.m_Right="10" m_Padding.m_Top="4" m_Padding.m_Bottom="4" m_Spacing="0" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="58" />
                <GameObject name="Name" id="StoneMineNameLabel">
                    <RectTransform m_SizeDelta="0, 22" />
                    <TextMeshProUGUI m_text="Stone Mine" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Category" id="StoneMineCategoryLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Extraction" m_fontSize="12" m_fontColor="#D5E4D5" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Cost" id="StoneMineCostLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Wood 10  Stone 8" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="WorkbenchCard" id="WorkbenchCard">
                <RectTransform m_SizeDelta="0, 58" />
                <Image m_Color="#405E50" m_RaycastTarget="true" />
                <Button m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E8F2E4" m_Colors.m_PressedColor="#C4D8BD" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_FadeDuration="0.08" />
                <VerticalLayoutGroup m_Padding.m_Left="10" m_Padding.m_Right="10" m_Padding.m_Top="4" m_Padding.m_Bottom="4" m_Spacing="0" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="58" />
                <GameObject name="Name" id="WorkbenchNameLabel">
                    <RectTransform m_SizeDelta="0, 22" />
                    <TextMeshProUGUI m_text="Workbench" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Category" id="WorkbenchCategoryLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Production" m_fontSize="12" m_fontColor="#D5E4D5" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
                <GameObject name="Cost" id="WorkbenchCostLabel">
                    <RectTransform m_SizeDelta="0, 18" />
                    <TextMeshProUGUI m_text="Wood 14  Stone 6" m_fontSize="12" m_fontColor="#BFD2BE" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>

            <GameObject name="CloseButton" id="CloseButton">
                <RectTransform m_SizeDelta="0, 36" />
                <Image m_Color="#334854" m_RaycastTarget="true" />
                <Button
                    m_Transition="1"
                    m_Colors.m_NormalColor="#FFFFFF"
                    m_Colors.m_HighlightedColor="#E5F4FA"
                    m_Colors.m_PressedColor="#C8DCE4"
                    m_Colors.m_DisabledColor="#6A7585AA"
                    m_Colors.m_FadeDuration="0.08" />
                <LayoutElement m_PreferredHeight="36" />

                <GameObject name="Label">
                    <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                    <TextMeshProUGUI
                        m_text="Close"
                        m_fontSize="16"
                        m_fontColor="#FFFFFF"
                        m_HorizontalAlignment="2"
                        m_VerticalAlignment="512"
                        m_RaycastTarget="false" />
                </GameObject>
            </GameObject>
        </GameObject>
    </GameObject>
</UnityPrefab>
