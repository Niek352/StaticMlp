<UnityPrefab>
    <GameObject name="MultiplayerStatusUi">
        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="0, 0" />
        <Canvas m_RenderMode="0" m_SortingOrder="100" />
        <CanvasScaler m_UiScaleMode="1" m_ReferenceResolution="1920, 1080" m_ScreenMatchMode="0" m_MatchWidthOrHeight="0.5" />
        <GraphicRaycaster />
        <MultiplayerStatusUi statusText="#StatusText" hostButton="#HostButton" serverButton="#ServerButton" clientButton="#ClientButton" disconnectButton="#DisconnectButton" />

        <GameObject name="Panel">
            <RectTransform m_AnchorMin="0, 1" m_AnchorMax="0, 1" m_Pivot="0, 1" m_SizeDelta="360, 178" m_AnchoredPosition="18, -18" />
            <Image m_Color="#16202BE6" m_RaycastTarget="true" />
            <VerticalLayoutGroup m_Padding.m_Left="14" m_Padding.m_Right="14" m_Padding.m_Top="12" m_Padding.m_Bottom="12" m_Spacing="10" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />

            <GameObject name="StatusText" id="StatusText">
                <RectTransform m_SizeDelta="0, 72" />
                <TextMeshProUGUI m_text="Multiplayer: Disconnected" m_fontSize="18" m_fontColor="#F2F7FB" m_HorizontalAlignment="1" m_VerticalAlignment="512" m_TextWrappingMode="1" m_overflowMode="1" m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="72" />
            </GameObject>

            <GameObject name="ButtonsRow">
                <RectTransform m_SizeDelta="0, 34" />
                <HorizontalLayoutGroup m_Spacing="8" m_ChildControlWidth="true" m_ChildControlHeight="true" m_ChildForceExpandWidth="true" m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="34" />

                <GameObject name="HostButton" id="HostButton">
                    <LayoutElement m_MinHeight="50" />
                    <RectTransform m_SizeDelta="78, 34" />
                    <Image m_Color="#2B7DE9" m_RaycastTarget="true" />
                    <Button m_Interactable="true" m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#DDEBFF" m_Colors.m_PressedColor="#B6D4FF" m_Colors.m_SelectedColor="#FFFFFF" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_ColorMultiplier="1" m_Colors.m_FadeDuration="0.08" />
                    <GameObject name="Label">
                        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                        <TextMeshProUGUI m_text="Host" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_TextWrappingMode="0" m_overflowMode="1" m_RaycastTarget="false" />
                    </GameObject>
                </GameObject>

                <GameObject name="ServerButton" id="ServerButton">
                    <RectTransform m_SizeDelta="78, 34" />
                    <LayoutElement m_MinHeight="50" />
                    
                    <Image m_Color="#33505F" m_RaycastTarget="true" />
                    <Button m_Interactable="true" m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E5F4FA" m_Colors.m_PressedColor="#C8DCE4" m_Colors.m_SelectedColor="#FFFFFF" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_ColorMultiplier="1" m_Colors.m_FadeDuration="0.08" />
                    <GameObject name="Label">
                        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                        <TextMeshProUGUI m_text="Server" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_TextWrappingMode="0" m_overflowMode="1" m_RaycastTarget="false" />
                    </GameObject>
                </GameObject>

                <GameObject name="ClientButton" id="ClientButton">
                    <RectTransform m_SizeDelta="78, 34" />
                    <LayoutElement m_MinHeight="50" />
                    
                    <Image m_Color="#33505F" m_RaycastTarget="true" />
                    <Button m_Interactable="true" m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#E5F4FA" m_Colors.m_PressedColor="#C8DCE4" m_Colors.m_SelectedColor="#FFFFFF" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_ColorMultiplier="1" m_Colors.m_FadeDuration="0.08" />
                    <GameObject name="Label">
                        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                        <TextMeshProUGUI m_text="Client" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_TextWrappingMode="0" m_overflowMode="1" m_RaycastTarget="false" />
                    </GameObject>
                </GameObject>
            </GameObject>

            <GameObject name="DisconnectButton" id="DisconnectButton">
                <RectTransform m_SizeDelta="0, 34" />
                <Image m_Color="#B84747" m_RaycastTarget="true" />
                <Button m_Interactable="false" m_Transition="1" m_Colors.m_NormalColor="#FFFFFF" m_Colors.m_HighlightedColor="#FFE6E6" m_Colors.m_PressedColor="#FFCACA" m_Colors.m_SelectedColor="#FFFFFF" m_Colors.m_DisabledColor="#6A7585AA" m_Colors.m_ColorMultiplier="1" m_Colors.m_FadeDuration="0.08" />
                <LayoutElement m_PreferredHeight="34" />
                <GameObject name="Label">
                    <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                    <TextMeshProUGUI m_text="Disconnect" m_fontSize="16" m_fontStyle="1" m_fontColor="#FFFFFF" m_HorizontalAlignment="2" m_VerticalAlignment="512" m_TextWrappingMode="0" m_overflowMode="1" m_RaycastTarget="false" />
                </GameObject>
            </GameObject>
        </GameObject>

        <GameObject name="EventSystem">
            <EventSystem />
            <InputSystemUIInputModule />
        </GameObject>
    </GameObject>
</UnityPrefab>
