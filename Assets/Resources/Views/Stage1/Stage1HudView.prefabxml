<UnityPrefab>
    <GameObject name="Stage1HudView" id="Root">
        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="0, 0" />
        <Canvas m_RenderMode="ScreenSpaceOverlay" m_SortingOrder="0" />
        <CanvasScaler m_UiScaleMode="ScaleWithScreenSize" m_ReferenceResolution="1920, 1080" m_ScreenMatchMode="MatchWidthOrHeight" m_MatchWidthOrHeight="0.5" />
        <GraphicRaycaster />
        <Stage1HudView
            canvas="#Root"
            graphicRaycaster="#Root"
            panelRoot="#Panel"
            closeButton="#CloseButton"
            buildButton="#BuildButton"
            expeditionButton="#ExpeditionButton"
            summaryLabel="#SummaryLabel" />

        <GameObject name="Panel" id="Panel" active="false">
            <RectTransform m_AnchorMin="0, 1" m_AnchorMax="0, 1" m_Pivot="0, 1" m_SizeDelta="420, 268" m_AnchoredPosition="18, -18" />
            <Image m_Color="#152128EE" m_RaycastTarget="true" />
            <VerticalLayoutGroup
                m_Padding.m_Left="14"
                m_Padding.m_Right="14"
                m_Padding.m_Top="12"
                m_Padding.m_Bottom="12"
                m_Spacing="10"
                m_ChildControlWidth="true"
                
                m_ChildForceExpandWidth="true"
                m_ChildForceExpandHeight="false" />

            <GameObject name="TitleRow">
                <RectTransform m_SizeDelta="0, 32" />
                <HorizontalLayoutGroup
                    m_Spacing="10"
                    m_ChildAlignment="4"
                    m_ChildControlWidth="true"
                    m_ChildControlHeight="true"
                    m_ChildForceExpandWidth="false"
                    m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="32" />

                <GameObject name="Title">
                    <RectTransform m_SizeDelta="324, 30" />
                    <TextMeshProUGUI
                        m_text="Camp Overview"
                        m_fontSize="22"
                        m_fontStyle="Bold"
                        m_fontColor="#F4F8F4"
                        m_HorizontalAlignment="Left"
                        m_VerticalAlignment="Middle"
                        m_RaycastTarget="false" />
                    <LayoutElement m_FlexibleWidth="1" m_PreferredHeight="30" />
                </GameObject>

                <GameObject name="CloseButton" id="CloseButton">
                    <RectTransform m_SizeDelta="32, 32" />
                    <Image m_Color="#5B6770" m_RaycastTarget="true" />
                    <Button
                        m_Transition="ColorTint"
                        m_Colors.m_NormalColor="#FFFFFF"
                        m_Colors.m_HighlightedColor="#F2F5F7"
                        m_Colors.m_PressedColor="#D4DDE2"
                        m_Colors.m_DisabledColor="#6A7585AA"
                        m_Colors.m_FadeDuration="0.08" />
                    <LayoutElement m_PreferredWidth="32" m_PreferredHeight="32" />

                    <GameObject name="Label">
                        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                        <TextMeshProUGUI
                            m_text="X"
                            m_fontSize="20"
                            m_fontStyle="Bold"
                            m_fontColor="#FFFFFF"
                            m_HorizontalAlignment="Center"
                            m_VerticalAlignment="Middle"
                            m_RaycastTarget="false" />
                    </GameObject>
                </GameObject>
            </GameObject>

            <GameObject name="SummaryLabel" id="SummaryLabel">
                <RectTransform m_SizeDelta="0, 160" />
                <TextMeshProUGUI
                    m_text="Objective: Stabilize the camp&#10;Camp stage: NotStarted&#10;Resources: Wood 0 / Stone 0&#10;Workers: 0/0 assigned&#10;Prepared build: Not prepared&#10;Expedition: Locked / Idle&#10;Threat: Calm / Raid None&#10;Boss flags: Unlocked=False Tokens=0"
                    m_fontSize="16"
                    m_fontColor="#D7E3D6"
                    m_HorizontalAlignment="Left"
                    m_VerticalAlignment="Top"
                    m_TextWrappingMode="Normal"
                    m_overflowMode="Truncate"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="160" />
            </GameObject>

            <GameObject name="ActionRow">
                <RectTransform m_SizeDelta="0, 42" />
                <HorizontalLayoutGroup
                    m_Spacing="10"
                    m_ChildControlWidth="true"
                    
                    m_ChildForceExpandWidth="true"
                    m_ChildForceExpandHeight="false" />
                <LayoutElement m_PreferredHeight="42" />

                <GameObject name="BuildButton" id="BuildButton">
                    <RectTransform m_SizeDelta="0, 42" />
                    <Image m_Color="#4C7A52" m_RaycastTarget="true" />
                    <Button
                        m_Transition="ColorTint"
                        m_Colors.m_NormalColor="#FFFFFF"
                        m_Colors.m_HighlightedColor="#E8F2E4"
                        m_Colors.m_PressedColor="#C4D8BD"
                        m_Colors.m_DisabledColor="#6A7585AA"
                        m_Colors.m_FadeDuration="0.08" />

                    <GameObject name="Label">
                        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                        <TextMeshProUGUI
                            m_text="Prepare Build"
                            m_fontSize="16"
                            m_fontStyle="Bold"
                            m_fontColor="#FFFFFF"
                            m_HorizontalAlignment="Center"
                            m_VerticalAlignment="Middle"
                            m_RaycastTarget="false" />
                    </GameObject>
                </GameObject>

                <GameObject name="ExpeditionButton" id="ExpeditionButton">
                    <RectTransform m_SizeDelta="0, 42" />
                    <Image m_Color="#33505F" m_RaycastTarget="true" />
                    <Button
                        m_Transition="ColorTint"
                        m_Colors.m_NormalColor="#FFFFFF"
                        m_Colors.m_HighlightedColor="#E5F4FA"
                        m_Colors.m_PressedColor="#C8DCE4"
                        m_Colors.m_DisabledColor="#6A7585AA"
                        m_Colors.m_FadeDuration="0.08" />

                    <GameObject name="Label">
                        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="1, 1" m_SizeDelta="0, 0" />
                        <TextMeshProUGUI
                            m_text="Open Expedition"
                            m_fontSize="16"
                            m_fontStyle="Bold"
                            m_fontColor="#FFFFFF"
                            m_HorizontalAlignment="Center"
                            m_VerticalAlignment="Middle"
                            m_RaycastTarget="false" />
                    </GameObject>
                </GameObject>
            </GameObject>
        </GameObject>
    </GameObject>
</UnityPrefab>
