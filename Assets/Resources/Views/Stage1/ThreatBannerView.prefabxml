<UnityPrefab>
    <GameObject name="ThreatBannerView" id="Root">
        <RectTransform m_AnchorMin="0, 0" m_AnchorMax="0, 0" m_Pivot="0, 0" m_SizeDelta="0, 0" />
        <Canvas m_RenderMode="ScreenSpaceOverlay" m_SortingOrder="0" />
        <CanvasScaler m_UiScaleMode="ScaleWithScreenSize" m_ReferenceResolution="1920, 1080" m_ScreenMatchMode="MatchWidthOrHeight" m_MatchWidthOrHeight="0.5" />
        <GraphicRaycaster />
        <ThreatBannerView
            canvas="#Root"
            graphicRaycaster="#Root"
            panelRoot="#Panel"
            summaryLabel="#SummaryLabel" />

        <GameObject name="Panel" id="Panel" active="false">
            <RectTransform m_AnchorMin="0.5, 1" m_AnchorMax="0.5, 1" m_Pivot="0.5, 1" m_SizeDelta="520, 96" m_AnchoredPosition="0, -18" />
            <Image m_Color="#3D1F25F2" m_RaycastTarget="true" />
            <VerticalLayoutGroup
                m_Padding.m_Left="18"
                m_Padding.m_Right="18"
                m_Padding.m_Top="12"
                m_Padding.m_Bottom="12"
                m_Spacing="6"
                m_ChildControlWidth="true"
                
                m_ChildForceExpandWidth="true"
                m_ChildForceExpandHeight="false" />

            <GameObject name="Header">
                <RectTransform m_SizeDelta="0, 24" />
                <TextMeshProUGUI
                    m_text="Settlement Threat"
                    m_fontSize="20"
                    m_fontStyle="Bold"
                    m_fontColor="#FFE7C8"
                    m_HorizontalAlignment="Center"
                    m_VerticalAlignment="Middle"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="24" />
            </GameObject>

            <GameObject name="SummaryLabel" id="SummaryLabel">
                <RectTransform m_SizeDelta="0, 42" />
                <TextMeshProUGUI
                    m_text="Threat: Calm | Raid: None | ActivateAtTick: 0"
                    m_fontSize="16"
                    m_fontColor="#FFF6EA"
                    m_HorizontalAlignment="Center"
                    m_VerticalAlignment="Middle"
                    m_TextWrappingMode="Normal"
                    m_overflowMode="Truncate"
                    m_RaycastTarget="false" />
                <LayoutElement m_PreferredHeight="42" />
            </GameObject>
        </GameObject>
    </GameObject>
</UnityPrefab>
